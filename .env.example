# Generate via: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DATABASE_URL=sqlite:///./runtime/insurance.db
DATA_DIR=./runtime
TOKEN_EXP_MINUTES=90
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=30
MAX_IMAGE_PIXELS=30000000
# Set only when frontend is hosted at a DIFFERENT, trusted origin
CORS_ORIGIN=
